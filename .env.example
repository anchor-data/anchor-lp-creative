# Copy to .env.local (Next dev + scripts) and .dev.vars (wrangler preview).
# Production values go in Cloudflare Secrets: `npx wrangler secret put NAME`.

# Turso. Local dev can use a libSQL file.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Auth: "access" verifies the Cf-Access-Jwt-Assertion header; "dev" signs everyone in as DEV_USER_EMAIL.
AUTH_MODE=dev
DEV_USER_EMAIL=admin@example.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=
# Comma-separated. These users become admin on first login (spec ch.3).
INITIAL_ADMIN_EMAILS=admin@example.com

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_LIGHT=claude-haiku-5-5

# Squad beyond external API (endpoint details pending: U-08)
SQUAD_BEYOND_BASE_URL=
SQUAD_BEYOND_API_KEY=

# Notifications (Slack/Chatwork incoming webhook; U-05)
NOTIFY_WEBHOOK_URL=

# Protects POST /api/dpro/candidates (method B) and /api/admin/jobs/*/run from cron-less callers
SERVICE_TOKEN=
